---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildEventSummary, buildProjectSummary } from "../lib/content-helpers";
import { impactosMissao, missaoCurta } from "../lib/identidade";

const todosProjetos = await getCollection("projects");
const todosEventos = await getCollection("events");
const todaEquipe = await getCollection("team");

const projetos = todosProjetos.slice(0, 3);
const eventos = [...todosEventos]
  .sort(
    (a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime(),
  )
  .slice(0, 3);

const metricas = [
  {
    rotulo: "Projetos cadastrados",
    valor: todosProjetos.length > 0 ? String(todosProjetos.length) : "+30",
  },
  {
    rotulo: "Eventos cadastrados",
    valor: todosEventos.length > 0 ? String(todosEventos.length) : "+20",
  },
  {
    rotulo: "Membros cadastrados",
    valor: todaEquipe.length > 0 ? String(todaEquipe.length) : "+15",
  },
];
---

<BaseLayout
  title="Início | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Laboratório acadêmico com atuação em pesquisa aplicada, formação e extensão."
>
  <section
    class="relative overflow-hidden rounded-3xl bg-surface-container-low p-8 shadow-2xl lg:p-16 border border-outline-variant/30"
  >
    <div
      class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-[100px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-20 left-0 h-48 w-48 rounded-full bg-secondary/5 blur-[80px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div class="animate-on-scroll">
        <p
          class="text-xs font-black uppercase tracking-[0.2em] text-primary"
        >
          Pesquisa aplicada em neurociência da visão
        </p>
        <h1
          class="mt-6 text-4xl leading-tight sm:text-6xl font-black tracking-tighter text-on-surface"
        >
          Produzimos <span class="text-primary italic font-serif">ciência confiável</span> para decisões reais.
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-on-surface-variant/90">
          O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
          integra pesquisa, ensino e extensão em um ecossistema acadêmico
          contemporâneo, com foco em método, clareza e impacto social.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/projetos"
            class="btn-primary"
          >
            Explorar projetos
          </a>
          <a
            href="/eventos"
            class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 bg-primary/5 px-6 py-3 text-sm font-bold uppercase tracking-widest text-primary transition duration-200 hover:bg-primary/10 hover:border-primary/50"
          >
            Ver agenda
          </a>
          <a
            href="/equipe"
            class="inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-bold uppercase tracking-widest text-on-surface-variant/90 transition duration-200 hover:text-primary"
          >
            Conheça a equipe
          </a>
        </div>
      </div>

      <aside
        class="animate-on-scroll delay-200 rounded-2xl bg-surface-container-high/50 backdrop-blur-md p-8 border border-outline-variant/30"
      >
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/90">
          Impacto em Números
        </p>
        <dl class="mt-8 space-y-6" id="indicadores-container">
          {
            metricas.map((item) => {
              const num = parseInt(item.valor.replace(/\D/g, ""));
              const isPlus = item.valor.includes("+");
              return (
                <div class="last:border-0">
                  <dt class="text-xs font-bold font-medium uppercase tracking-widest text-on-surface-variant/90">{item.rotulo}</dt>
                  <dd class="mt-2 text-5xl font-black tracking-tighter text-primary">
                    {isPlus && "+"}
                    <span class="contador" data-target={num}>
                      0
                    </span>
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </aside>
    </div>
  </section>

  <section class="pt-16">
    <div class="grid gap-12 rounded-3xl bg-surface-container-low p-8 lg:grid-cols-[1fr_1.2fr] lg:p-12 border border-outline-variant/30">
      <div class="animate-on-scroll">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-primary">
          O que fazemos e por que importa
        </p>
        <h2 class="mt-6 text-3xl font-serif font-bold text-on-surface leading-snug">
          {missaoCurta}
        </h2>
        <a
          href="/sobre-o-laboratorio/missao-e-valores"
          class="mt-8 inline-flex items-center text-xs font-black uppercase tracking-widest text-primary transition duration-200 hover:text-primary-light"
        >
          Conheça a missão e valores →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {
          impactosMissao.map((impacto, index) => (
            <article
              class={`animate-on-scroll rounded-2xl bg-surface-container-high/40 p-6 transition duration-300 hover:bg-surface-container-high border border-outline-variant/30 ${
                index === 1 ? "delay-100" : index === 2 ? "delay-200" : ""
              }`}
            >
              <p class="text-sm leading-relaxed text-on-surface-variant/90 font-medium">{impacto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <section id="projetos" class="pt-24">
    <div class="flex items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-2">Portfolio</p>
        <h2 class="text-4xl font-black tracking-tighter text-on-surface">Projetos em Destaque</h2>
      </div>
      <a
        href="/projetos"
        class="text-xs font-black uppercase tracking-widest text-primary transition hover:text-primary-light"
        >Ver todos os projetos →</a
      >
    </div>
    <div class="mt-6 grid gap-8 md:grid-cols-3">
      {
        projetos.length > 0 ? (
          projetos.map((projeto, i) => (
            <article
              class={`animate-on-scroll card-tonal border border-outline-variant/5 group ${
                i === 1 ? "delay-100" : i === 2 ? "delay-200" : ""
              }`}
            >
              <h3 class="text-xl font-bold text-on-surface transition-colors group-hover:text-primary leading-tight">
                <a href={`/projetos/${projeto.id}/`}>
                  {projeto.data.titulo}
                </a>
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-on-surface-variant/80">
                {buildProjectSummary(projeto.data)}
              </p>
              <a
                href={`/projetos/${projeto.id}/`}
                class="mt-6 inline-flex text-xs font-black uppercase tracking-widest text-primary transition hover:text-primary-light"
              >
                Detalhes do projeto →
              </a>
            </article>
          ))
        ) : (
          <p class="text-on-surface-variant md:col-span-3">
            Nenhum projeto cadastrado no momento.
          </p>
        )
      }
    </div>
  </section>

  <section id="eventos" class="pt-24 pb-12">
    <div class="flex items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-2">Comunidade</p>
        <h2 class="text-4xl font-black tracking-tighter text-on-surface">Próximos Eventos</h2>
      </div>
      <a
        href="/eventos"
        class="text-xs font-black uppercase tracking-widest text-primary transition hover:text-primary-light"
        >Agenda completa →</a
      >
    </div>
    <div class="mt-6 grid gap-8 md:grid-cols-3">
      {
        eventos.length > 0 ? (
          eventos.map((evento, i) => (
            <article
              class={`animate-on-scroll card-tonal border border-outline-variant/5 group ${
                i === 1 ? "delay-100" : i === 2 ? "delay-200" : ""
              }`}
            >
              <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-primary">
                  {new Intl.DateTimeFormat("pt-BR", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                  }).format(new Date(evento.data.data))}
                </span>
                <span class="w-1 h-1 rounded-full bg-outline-variant/30"></span>
                <span class="text-[10px] font-bold uppercase tracking-[0.1em] text-on-surface-variant/80">{evento.data.local}</span>
              </div>
              
              <h3 class="text-xl font-bold text-on-surface transition-colors group-hover:text-primary leading-tight">
                <a href={`/eventos/${evento.id}/`}>
                  {evento.data.titulo}
                </a>
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-on-surface-variant/80">
                {buildEventSummary(evento.data)}
              </p>
              <a
                href={`/eventos/${evento.id}/`}
                class="mt-6 inline-flex text-xs font-black uppercase tracking-widest text-primary transition hover:text-primary-light"
              >
                Ver evento →
              </a>
            </article>
          ))
        ) : (
          <p class="text-on-surface-variant md:col-span-3">
            Nenhum evento cadastrado no momento.
          </p>
        )
      }
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const counters = document.querySelectorAll(".contador");

      /** @param {HTMLElement} el */
      const animateCounter = (el) => {
        const target = +el.getAttribute("data-target");
        if (!target) return;
        const duration = 2000;
        const stepTime = Math.max(Math.floor(duration / target), 10);
        let current = 0;

        const timer = setInterval(() => {
          current += Math.ceil(target / (duration / stepTime));
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }
          el.innerText = current;
        }, stepTime);
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px", threshold: 0.5 },
      );

      counters.forEach((counter) => observer.observe(counter));
    });
  </script>
</BaseLayout>
