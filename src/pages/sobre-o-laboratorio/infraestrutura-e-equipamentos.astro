---
import BaseLayout from "../../layouts/BaseLayout.astro";

const equipamentos = [
  "Acuidade visual",
  "Visão funcional",
  "Aberrometria",
  "Sensibilidade ao contraste",
  "Foto-retinoscopia digital",
  "Ofuscamento",
  "Processamento magnocelular",
  "Frequency Doubling Technology",
  "Rastreamento ocular (Eyetracker)",
  "Diagnóstico perceptual da Síndrome de Irlen",
];
---

<BaseLayout
  title="Infraestrutura e equipamentos | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Infraestrutura e equipamentos do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center mb-16">
    <div class="animate-on-scroll">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Sobre o Laboratório</p>
      <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight mb-8">Infraestrutura e Equipamentos</h1>
      <p class="text-lg leading-relaxed text-on-surface-variant/90 font-medium mb-6">
        O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
        reuniu equipamentos voltados à avaliação funcional, à análise
        perceptual e ao desenvolvimento de protocolos técnicos para pesquisa
        aplicada.
      </p>
      <p class="text-base leading-relaxed text-on-surface-variant/80 font-medium mb-10">
        A infraestrutura foi organizada para apoiar triagens, estudos de leitura,
        avaliação ocular e desenvolvimento de instrumentos com maior precisão.
      </p>
      <ul class="grid gap-3 text-sm text-on-surface-variant font-bold sm:grid-cols-2">
        {equipamentos.map((item) => (
          <li class="flex items-center gap-3 p-4 rounded-xl bg-surface-container-low border border-outline-variant/30 shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <figure class="animate-on-scroll delay-200 overflow-hidden rounded-[2.5rem] border border-outline-variant/30 bg-surface-container-low shadow-2xl p-4">
      <img
        src="/images/sobre-o-laboratorio/infraestrutura.jpg"
        alt="Infraestrutura de pesquisa do laboratório"
        class="rounded-[1.5rem] w-full object-cover opacity-80"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>
</BaseLayout>
