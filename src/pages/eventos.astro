---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildEventSummary } from "../lib/content-helpers";

const eventos = await getCollection("events");
const hoje = new Date();
hoje.setHours(0, 0, 0, 0);

const ordenados = [...eventos].sort((a, b) => {
  const dataA = new Date(a.data.data);
  const dataB = new Date(b.data.data);
  const futuroA = dataA >= hoje;
  const futuroB = dataB >= hoje;

  if (futuroA && !futuroB) return -1;
  if (!futuroA && futuroB) return 1;

  if (futuroA && futuroB) return dataA.getTime() - dataB.getTime();
  return dataB.getTime() - dataA.getTime();
});

const anosDisponiveis = [...new Set(ordenados.map((evento) => new Date(evento.data.data).getFullYear()))].sort((a, b) => b - a);

const formatarData = (data) =>
  new Intl.DateTimeFormat("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(data);

const semCropImages = new Set([
  "/images/eventos/cbnv-6.png",
  "/images/eventos/cbnv-7.png",
]);

const semCropLandscape862x307 = new Set([
  "/images/eventos/cbnv-1.png",
  "/images/eventos/cbnv-2.png",
  "/images/eventos/cbnv-3.png",
  "/images/eventos/cbnv-8.png",
  "/images/eventos/cbnv-9.png",
  "/images/eventos/cbnv-11.png",
  "/images/eventos/cbnv-12.png",
  "/images/eventos/curso-darv.png",
  "/images/eventos/reuniao-cientifica-abril.png",
]);
---

<BaseLayout
  title="Eventos | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Agenda de eventos do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN), com próximos eventos em destaque."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Agenda</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Eventos</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
      Acompanhe congressos, cursos e encontros científicos promovidos pelo
      Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN).
    </p>
  </section>

  {ordenados.length === 0 ? (
    <section class="mt-8 rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
      <p class="text-on-surface-variant/90 font-medium">Nenhum evento cadastrado no momento.</p>
    </section>
  ) : (
    <section class="space-y-8">
      <div class="flex items-center gap-4 p-6 bg-surface-container-low rounded-2xl border border-outline-variant/30 mb-12">
        <label for="filtro-ano-evento" class="text-xs font-black uppercase tracking-widest text-on-surface-variant/90">Filtrar por ano:</label>
        <select
          id="filtro-ano-evento"
          class="rounded-xl border border-outline-variant/30 bg-surface-container-high px-6 py-2.5 text-sm font-bold text-on-surface shadow-sm focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10 transition-all cursor-pointer"
        >
          <option value="todos">Todos os anos</option>
          {anosDisponiveis.map((ano) => (
            <option value={String(ano)}>{ano}</option>
          ))}
        </select>
      </div>

      <div class="grid gap-8">
        {ordenados.map((evento) => {
          const dataEvento = new Date(evento.data.data);
          const ehFuturo = dataEvento >= hoje;
          const anoEvento = dataEvento.getFullYear();

          return (
            <article class="evento-item group rounded-3xl bg-surface-container-low p-8 border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high shadow-xl shadow-black/20" data-ano={String(anoEvento)}>
              <div class="flex flex-col lg:flex-row gap-10">
                {evento.data.imagem && (
                  <div class="lg:w-1/3 shrink-0">
                    <div class="relative overflow-hidden rounded-2xl aspect-[16/10] h-full">
                      <img
                        src={evento.data.imagem}
                        alt={`Imagem do evento ${evento.data.titulo}`}
                        class={["h-full w-full transition-transform duration-500 group-hover:scale-105", semCropLandscape862x307.has(evento.data.imagem) ? "object-contain bg-surface-container-highest p-4" : semCropImages.has(evento.data.imagem) ? "object-contain bg-surface-container-highest p-4" : "object-cover"].join(" ")}
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                    </div>
                  </div>
                )}
                
                <div class="flex-1 flex flex-col">
                  <div class="flex flex-wrap items-center gap-4 mb-4">
                    <span class="text-xs font-black uppercase tracking-[0.2em] text-primary">
                      {formatarData(dataEvento)}
                    </span>
                    <span class={`rounded-full px-4 py-1.5 text-[10px] font-black uppercase tracking-widest border ${ehFuturo ? "bg-primary/10 text-primary border-primary/20" : "bg-on-surface-variant/10 text-on-surface-variant/90 border-outline-variant/30"}`}>
                      {ehFuturo ? "Próximo" : "Realizado"}
                    </span>
                  </div>

                  <h2 class="text-3xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight mb-3">
                    <a href={`/eventos/${evento.id}/`}>
                      {evento.data.titulo}
                    </a>
                  </h2>
                  
                  <div class="flex items-center gap-2 mb-6 text-secondary/90">
                    <span class="material-symbols-outlined text-lg" data-icon="location_on">location_on</span>
                    <p class="text-sm font-bold uppercase tracking-widest">{evento.data.local}</p>
                  </div>

                  <p class="text-base leading-relaxed text-on-surface-variant/90 line-clamp-3 mb-8 font-medium">
                    {buildEventSummary(evento.data)}
                  </p>

                  <div class="mt-auto flex flex-wrap gap-4">
                    <a
                      href={`/eventos/${evento.id}/`}
                      class="btn-primary text-xs uppercase tracking-widest py-3 px-6"
                    >
                      Ver detalhes do evento →
                    </a>
                    {evento.data.link && (
                      <a
                        href={evento.data.link}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 px-6 py-3 text-xs font-bold uppercase tracking-widest text-on-surface-variant transition hover:border-primary/50 hover:text-primary hover:bg-primary/5"
                      >
                        <span class="material-symbols-outlined text-sm" data-icon="open_in_new">open_in_new</span>
                        Página oficial
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      
      <p id="eventos-sem-resultado" class="hidden rounded-2xl bg-surface-container-low p-8 text-on-surface-variant font-medium border border-outline-variant/10">
        Nenhum evento encontrado para o ano selecionado.
      </p>
    </section>
  )}

  <script>
    const filtroAno = document.querySelector("#filtro-ano-evento");
    const eventos = document.querySelectorAll(".evento-item");
    const semResultado = document.querySelector("#eventos-sem-resultado");

    if (filtroAno && eventos.length > 0 && semResultado) {
      const aplicarFiltro = () => {
        const anoSelecionado = filtroAno.value;
        let visiveis = 0;

        eventos.forEach((evento) => {
          const deveMostrar = anoSelecionado === "todos" || evento.dataset.ano === anoSelecionado;
          evento.classList.toggle("hidden", !deveMostrar);
          if (deveMostrar) visiveis += 1;
        });

        semResultado.classList.toggle("hidden", visiveis > 0);
      };

      filtroAno.addEventListener("change", aplicarFiltro);
      aplicarFiltro();
    }
  </script>
</BaseLayout>
