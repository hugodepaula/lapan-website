---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import publicacoesBrutas from "../../../content/zotero.json";
import { buildPersonSummary, buildProjectSummary } from "../../lib/content-helpers";
import { matchesAuthorName } from "../../lib/entities";
import { buildAbsoluteUrl, buildAssetUrl, getBaseUrl } from "../../lib/geo";
import { normalizarPublicacoes } from "../../lib/publicacoes";
import { siteName } from "../../lib/site";

export async function getStaticPaths() {
  const membros = await getCollection("team");

  return membros.map((membro) => ({
    params: { slug: membro.id },
    props: { membro },
  }));
}

const { membro } = Astro.props;
const projetos = await getCollection("projects");
const relacionados = projetos
  .filter((projeto) => projeto.data.equipe.includes(membro.id))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"));

const { publicacoes } = normalizarPublicacoes(publicacoesBrutas);
const publicacoesRelacionadas = publicacoes
  .filter((publicacao) => matchesAuthorName(membro.data.nome, publicacao.autores))
  .slice(0, 10);

const resumo = buildPersonSummary(membro.data);
const baseUrl = getBaseUrl(Astro.site);
const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
const image = membro.data.foto
  ? buildAssetUrl(membro.data.foto, baseUrl)
  : undefined;
const sameAs = [
  ...membro.data.links.map((link) => link.url),
  ...(membro.data.orcid ? [membro.data.orcid] : []),
].filter(Boolean);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: `${membro.data.nome} | Equipe ${siteName}`,
    description: resumo,
    mainEntity: {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      name: membro.data.nome,
      description: resumo,
      image,
      email: membro.data.email,
      jobTitle: membro.data.cargo,
      worksFor: {
        "@id": `${baseUrl.toString()}#organization`,
      },
      affiliation: membro.data.afiliacao
        ? {
            "@type": "Organization",
            name: membro.data.afiliacao,
          }
        : undefined,
      sameAs,
      knowsAbout: membro.data.areasAtuacao,
    },
  },
];
---

<BaseLayout
  title={`${membro.data.nome} | Equipe LAPAN`}
  description={resumo}
  image={membro.data.foto}
  pageType="profile"
  breadcrumbs={[
    { name: "Início", item: "/" },
    { name: "Equipe", item: "/equipe/" },
    { name: membro.data.nome },
  ]}
  structuredData={structuredData}
>
  <section class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div class="animate-on-scroll sticky top-24">
      <div class="rounded-3xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-2xl shadow-black/40">
        <div class="relative overflow-hidden rounded-2xl aspect-[4/5] mb-8 group">
          <img
            src={membro.data.foto || "/images/logo_squared.png"}
            alt={`Foto de ${membro.data.nome}`}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent opacity-60"></div>
        </div>

        <div class="space-y-6">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-primary/10 border border-primary/30 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest text-primary">
              {membro.data.tipo}
            </span>
            {membro.data.afiliacao && (
              <span class="rounded-full bg-on-surface-variant/5 border border-outline-variant/30 px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80">
                {membro.data.afiliacao}
              </span>
            )}
          </div>

          <div class="pt-6 border-t border-outline-variant/30">
            <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/80 mb-4">Canais de Contato</h3>
            <ul class="space-y-3">
              {membro.data.email && (
                <li>
                  <a
                    href={`mailto:${membro.data.email}`}
                    class="flex items-center gap-3 text-sm font-bold text-on-surface-variant hover:text-primary transition-colors group"
                  >
                    <span class="material-symbols-outlined text-primary text-lg group-hover:scale-110 transition-transform" data-icon="alternate_email">alternate_email</span>
                    E-mail Institucional
                  </a>
                </li>
              )}
              {membro.data.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noreferrer"
                    class="flex items-center gap-3 text-sm font-bold text-on-surface-variant hover:text-primary transition-colors group"
                  >
                    <span class="material-symbols-outlined text-primary text-lg group-hover:scale-110 transition-transform" data-icon="link">link</span>
                    {link.rotulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="animate-on-scroll delay-200">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Investigador</p>
      <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight mb-4">{membro.data.nome}</h1>
      <p class="text-xl font-bold text-secondary tracking-tight mb-8">{membro.data.cargo}</p>
      
      <div class="prose prose-invert max-w-none">
        <p class="text-lg leading-relaxed text-on-surface-variant/90 font-medium mb-6">
          {resumo}
        </p>
        <p class="text-base leading-relaxed text-on-surface-variant/80">
          {membro.data.bio}
        </p>
      </div>

      {membro.data.credenciais.length > 0 && (
        <section class="pt-16">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Credenciais e Formação</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {membro.data.credenciais.map((item) => (
              <li class="rounded-xl bg-surface-container-low border border-outline-variant/30 px-6 py-4 text-sm font-bold text-on-surface-variant/80 shadow-lg">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )}

      {membro.data.areasAtuacao.length > 0 && (
        <section class="pt-16">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Áreas de Especialidade</h2>
          <ul class="flex flex-wrap gap-3">
            {membro.data.areasAtuacao.map((area) => (
              <li class="rounded-lg bg-surface-container-high border border-outline-variant/30 px-4 py-2 text-xs font-black uppercase tracking-widest text-primary">
                {area}
              </li>
            ))}
          </ul>
        </section>
      )}

      {membro.data.destaques.length > 0 && (
        <section class="pt-16">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Destaques Profissionais</h2>
          <ul class="space-y-4">
            {membro.data.destaques.map((item) => (
              <li class="rounded-2xl bg-surface-container-low border border-outline-variant/30 p-6 text-sm leading-relaxed text-on-surface-variant/80 italic font-medium">
                "{item}"
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>

  <section class="pt-24">
    <div class="flex items-end justify-between gap-4 mb-10">
      <h2 class="text-3xl font-black tracking-tighter text-on-surface">Projetos Relacionados</h2>
      <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/80">{relacionados.length} projeto(s) em curso</p>
    </div>
    {relacionados.length === 0 ? (
      <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
        <p class="text-on-surface-variant/80 font-medium italic">
          Nenhum projeto vinculado diretamente a este perfil na base atual.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-3">
        {relacionados.map((projeto) => (
          <article class="group rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1">
            <span class="text-[10px] font-black uppercase tracking-widest text-primary mb-3 block">
              {projeto.data.status}
            </span>
            <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors leading-tight mb-4">
              <a href={`/projetos/${projeto.id}/`}>
                {projeto.data.titulo}
              </a>
            </h3>
            <p class="text-xs font-medium leading-relaxed text-on-surface-variant/80 line-clamp-3">
              {buildProjectSummary(projeto.data)}
            </p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="pt-24 pb-12">
    <div class="flex items-end justify-between gap-4 mb-10">
      <h2 class="text-3xl font-black tracking-tighter text-on-surface">Produção Científica</h2>
      <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/80">Últimas {publicacoesRelacionadas.length} publicações</p>
    </div>
    {publicacoesRelacionadas.length === 0 ? (
      <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
        <p class="text-on-surface-variant/80 font-medium italic">
          Vínculo automático de publicações pendente de metadados Zotero.
        </p>
      </div>
    ) : (
      <div class="space-y-4">
        {publicacoesRelacionadas.map((publicacao) => (
          <article class="group rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 hover:bg-surface-container-high transition-colors">
            <p class="text-sm leading-relaxed text-on-surface-variant/90 font-medium group-hover:text-on-surface transition-colors">
              {publicacao.referenciaAbnt}
            </p>
            {(publicacao.doiUrl || publicacao.urlExterna) && (
              <div class="mt-4 flex gap-4">
                {publicacao.doiUrl && (
                  <a
                    href={publicacao.doiUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="text-[10px] font-black uppercase tracking-widest text-primary hover:text-primary-light"
                  >
                    DOI →
                  </a>
                )}
                {publicacao.urlExterna && (
                  <a
                    href={publicacao.urlExterna}
                    target="_blank"
                    rel="noreferrer"
                    class="text-[10px] font-black uppercase tracking-widest text-primary hover:text-primary-light"
                  >
                    Acessar Fonte →
                  </a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
