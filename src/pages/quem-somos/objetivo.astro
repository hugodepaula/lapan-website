---
import BaseLayout from "../../layouts/BaseLayout.astro";

const objetivos = [
  {
    titulo: "Identificar e tratar dificuldades ligadas à visão",
    descricao:
      "Desenvolver e testar estratégias para identificar e tratar dificuldades de aprendizagem que podem estar ligadas à visão, como problemas na leitura, desconforto visual e fadiga, que afetam o rendimento escolar.",
  },
  {
    titulo: "Conectar saúde, educação e pesquisa",
    descricao:
      "Fortalecer redes cooperativas entre profissionais de saúde, educação e pesquisa para acelerar diagnósticos, intervenções e o compartilhamento de boas práticas.",
  },
  {
    titulo: "Acompanhar o desenvolvimento infantil",
    descricao:
      "Acompanhar o desenvolvimento de crianças ao longo da vida escolar para reconhecer sinais de alerta e orientar intervenções precoces. Isso ajuda a reduzir atrasos no aprendizado e melhora o encaminhamento na saúde e na escola.",
  },
  {
    titulo: "Criar referências para avaliação segura",
    descricao:
      "Mapear padrões esperados de desenvolvimento visual e sensorial para apoiar avaliações mais precisas e decisões clínicas baseadas em evidências.",
  },
  {
    titulo: "Intervir no tempo certo",
    descricao:
      "Apoiar a identificação precoce de crianças fora da curva esperada, facilitando cuidados mais rápidos e reduzindo impactos acumulados na aprendizagem e no bem-estar.",
  },
  {
    titulo: "Transformar achados em soluções práticas",
    descricao:
      "Converter os problemas encontrados em protocolos, instrumentos e orientações que possam ser usados por profissionais e instituições no cuidado diário.",
  },
];

const linhasPesquisa = [
  {
    titulo: "Leitura com conforto e menos fadiga",
    descricao:
      "Investigamos como luz e estímulos visuais influenciam a leitura e testamos ferramentas, como filtros, para reduzir desconforto visual e melhorar a experiência de leitura em crianças e adultos.",
  },
  {
    titulo: "Movimentos oculares e desempenho funcional",
    descricao:
      "Estudamos como os olhos acompanham textos, números e tarefas do dia a dia para identificar sinais que possam afetar leitura, atenção e coordenação visual.",
  },
  {
    titulo: "Tecnologias para diagnóstico mais objetivo",
    descricao:
      "Desenvolvemos e validamos equipamentos e métodos de avaliação para tornar o diagnóstico visual mais preciso, comparável e útil na prática clínica e educacional.",
  },
];
---

<BaseLayout
  title="Objetivo | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Objetivos e linhas de pesquisa do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section>
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">Quem Somos</p>
    <h1 class="mt-3 text-4xl text-brand-900 sm:text-5xl">Objetivo</h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
      Os objetivos do Laboratório de Pesquisa Aplicação à Neurociências da
      Visão (LAPAN) orientam pesquisas e ações voltadas a benefícios concretos
      para crianças, famílias, escolas e serviços de saúde.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {objetivos.map((item) => (
        <article class="rounded-2xl border border-brand-200 bg-surface p-5 shadow-soft">
          <h2 class="text-xl text-brand-900">{item.titulo}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.descricao}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="pt-12 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
    <figure class="overflow-hidden rounded-2xl border border-brand-200 bg-surface shadow-soft">
      <img
        src="/images/quem-somos/objetivos.png"
        alt="Representação visual dos objetivos de pesquisa"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div>
      <h2 class="text-3xl text-brand-900">Linhas de pesquisa</h2>
      <div class="mt-4 grid gap-4">
        {linhasPesquisa.map((linha) => (
          <article class="rounded-2xl border border-brand-200 bg-surface p-5 shadow-soft">
            <h3 class="text-xl text-brand-900">{linha.titulo}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{linha.descricao}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
