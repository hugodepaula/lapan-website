---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  missaoCompleta,
  missaoCurta,
  valoresInstitucionais,
} from "../../lib/identidade";

const destaques = [
  {
    titulo: "Missão e valores",
    descricao: "Propósito institucional e princípios que orientam a atuação do laboratório.",
    href: "/sobre-o-laboratorio/missao-e-valores"
  },
  {
    titulo: "História e fundadores",
    descricao: "Origem da parceria institucional e trajetória construída com a UFMG e o HOlhos.",
    href: "/sobre-o-laboratorio/historia-e-fundadores"
  },
  {
    titulo: "Infraestrutura e equipamentos",
    descricao: "Recursos técnicos utilizados nas avaliações e no desenvolvimento científico.",
    href: "/sobre-o-laboratorio/infraestrutura-e-equipamentos"
  }
];
---

<BaseLayout
  title="Quem Somos | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="História e propósito do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">Institucional</p>
      <h1 class="mt-3 text-4xl text-brand-900 sm:text-5xl">Quem Somos</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-700">
        {missaoCurta}
      </p>
      <a
        href="#missao-e-valores"
        class="mt-4 inline-flex items-center text-sm font-semibold text-accent-700 transition duration-200 hover:text-accent-600"
      >
        Conheça a missão e valores
      </a>
      <p class="mt-5 text-base leading-relaxed text-neutral-700">
        O <strong class="text-brand-900">Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)</strong>
        atua desde 2009 para transformar pesquisa em soluções que ajudam a
        identificar e tratar alterações visuais que podem prejudicar a
        aprendizagem, a leitura e o desenvolvimento, especialmente na infância.
      </p>
      <p class="mt-4 text-base leading-relaxed text-neutral-700">
        Nosso foco é fazer a ciência chegar na ponta: transformar evidências em
        práticas clínicas, materiais e orientações que apoiem profissionais de
        saúde e educação, para que mais pessoas recebam avaliação e intervenção
        no tempo certo. Criado pelo Hospital de Olhos Dr. Ricardo Guimarães
        (HOlhos) e pela Universidade Federal de Minas Gerais (UFMG), o LAPAN
        conecta pesquisa, atendimento, cursos e eventos para ampliar o impacto
        da Neurociências da Visão na vida cotidiana.
      </p>
    </div>

    <figure class="overflow-hidden rounded-2xl border border-brand-200 bg-surface shadow-soft">
      <img
        src="/images/quem-somos/logo-lapan.png"
        alt="Logo histórico do LAPAN"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section id="missao-e-valores" class="pt-14">
    <div class="max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">
        Missão e valores
      </p>
      <h2 class="mt-3 text-3xl text-brand-900">Ciência aplicada com compromisso público</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-700">
        {missaoCompleta}
      </p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {valoresInstitucionais.map((valor, index) => (
        <article
          class={`animate-on-scroll rounded-2xl border border-brand-200 bg-surface p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brand-300 ${
            index % 4 === 1
              ? "delay-100"
              : index % 4 === 2
                ? "delay-200"
                : index % 4 === 3
                  ? "delay-300"
                  : ""
          }`}
        >
          <h3 class="text-lg text-brand-900">{valor.titulo}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">{valor.descricao}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="pt-14">
    <h2 class="text-3xl text-brand-900">Estrutura da página institucional</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {destaques.map((item) => (
        <article class="rounded-2xl border border-brand-200 bg-surface p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-soft">
          <h3 class="text-xl text-brand-900">{item.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.descricao}</p>
          <a href={item.href} class="mt-4 inline-flex text-sm font-semibold text-accent-700 transition hover:text-accent-600">
            Acessar seção
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
