---
import BaseLayout from "../../layouts/BaseLayout.astro";

const secoes = [
  {
    titulo: "Missão e valores",
    descricao: "Entenda o propósito institucional do laboratório e os princípios que orientam suas decisões e pesquisas.",
    href: "/sobre-o-laboratorio/missao-e-valores",
  },
  {
    titulo: "História e fundadores",
    descricao: "Conheça a origem da parceria entre UFMG e HOlhos, a contribuição do Prof. Marcos Pinotti e os marcos da trajetória institucional.",
    href: "/sobre-o-laboratorio/historia-e-fundadores",
  },
  {
    titulo: "Infraestrutura e equipamentos",
    descricao: "Veja os recursos técnicos e os equipamentos usados nas avaliações e no desenvolvimento de soluções aplicadas.",
    href: "/sobre-o-laboratorio/infraestrutura-e-equipamentos",
  },
  {
    titulo: "Metodologia e evidências",
    descricao: "Entenda como o site organiza fontes, conteúdo canônico, metadados estruturados e revisão editorial.",
    href: "/sobre-o-laboratorio/metodologia-e-evidencias",
  },
];
---

<BaseLayout
  title="Sobre o Laboratório | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Visão geral institucional do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center mb-16">
    <div class="animate-on-scroll">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Institucional</p>
      <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Sobre o Laboratório</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/90 font-medium">
        O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
        transformou pesquisa em soluções para identificar alterações visuais que
        podem impactar leitura, aprendizagem e desenvolvimento. Nesta seção,
        você encontra os principais pontos da identidade institucional, da
        história e da infraestrutura que sustentaram esse trabalho.
      </p>
    </div>

    <figure class="animate-on-scroll delay-200 overflow-hidden rounded-3xl border border-outline-variant/10 bg-surface-container-low shadow-2xl p-8">
      <img
        src="/images/sobre-o-laboratorio/logo-lapan.png"
        alt="Logo histórico do LAPAN"
        class="h-auto w-full brightness-110"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="pb-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {secoes.map((item) => (
        <article class="group card-tonal border border-outline-variant/5 flex flex-col h-full">
          <h2 class="text-2xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight mb-4">{item.titulo}</h2>
          <p class="text-sm leading-relaxed text-on-surface-variant/70 mb-8 font-medium">{item.descricao}</p>
          <div class="mt-auto">
            <a href={item.href} class="text-xs font-black uppercase tracking-[0.2em] text-primary hover:text-primary-light transition-colors inline-flex items-center gap-2">
              Explorar
              <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
