---
import BaseLayout from "../layouts/BaseLayout.astro";
import publicacoesBrutas from "../../content/zotero.json";
import {
  agruparPublicacoesPorAno,
  normalizarPublicacoes,
} from "../lib/publicacoes";

const { publicacoes, problemas } = normalizarPublicacoes(publicacoesBrutas);
const publicacoesPorAno = agruparPublicacoesPorAno(publicacoes);
---

<BaseLayout
  title="Publicações | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Publicações científicas do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN), agrupadas por ano."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Produção científica</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Publicações</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
      Aqui você encontra artigos, teses e materiais do Laboratório de Pesquisa
      Aplicada à Neurociências da Visão (LAPAN). Se você é profissional de
      saúde, educação, estudante ou imprensa, use o filtro por ano para
      localizar evidências e referências aplicáveis.
    </p>
  </section>

  {
    publicacoes.length > 0 && (
      <section class="mb-12 flex flex-wrap items-center gap-4 p-6 bg-surface-container-low rounded-2xl border border-outline-variant/30">
        <label for="filtro-ano" class="text-xs font-black uppercase tracking-widest text-on-surface-variant/80">
          Filtrar por ano:
        </label>
        <select
          id="filtro-ano"
          class="rounded-xl border border-outline-variant/30 bg-surface-container-high px-6 py-2.5 text-sm font-bold text-on-surface shadow-sm focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10 transition-all cursor-pointer"
        >
          <option value="todos">Todos os anos</option>
          {publicacoesPorAno.map(([ano]) => (
            <option value={ano}>{ano}</option>
          ))}
        </select>
      </section>
    )
  }

  {
    publicacoes.length === 0 ? (
      <section class="mt-8 rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
        <p class="text-on-surface-variant/90 font-medium">
          Nenhuma publicação disponível no momento.
        </p>
      </section>
    ) : (
      <section class="space-y-16" id="lista-publicacoes">
        {publicacoesPorAno.map(([ano, itens]) => (
          <section
            aria-labelledby={`ano-${ano}`}
            class="secao-ano"
            data-ano={ano}
          >
            <div class="flex items-center justify-between gap-4 mb-8 border-l-4 border-primary pl-4">
              <h2 id={`ano-${ano}`} class="text-3xl font-bold text-on-surface">
                Ano {ano}
              </h2>
              <span class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/70">
                {itens.length} publicação(ões)
              </span>
            </div>

            <ol class="space-y-4">
              {itens.map((publicacao) => (
                <li class="group rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 hover:bg-surface-container-high transition-all duration-300">
                  <p class="text-base leading-relaxed text-on-surface-variant/90 font-medium group-hover:text-on-surface transition-colors">
                    {publicacao.referenciaAbnt}
                  </p>

                  {(publicacao.doiUrl || publicacao.urlExterna) && (
                    <div class="mt-6 flex flex-wrap items-center gap-4">
                      <span class="text-[10px] font-black uppercase tracking-widest text-primary/80">Acesso Digital</span>
                      <div class="flex gap-2">
                        {publicacao.doiUrl && (
                          <a
                            href={publicacao.doiUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/10 border border-primary/30 text-[10px] font-black text-primary uppercase tracking-widest hover:bg-primary/20 transition-colors"
                          >
                            <span class="material-symbols-outlined text-sm" data-icon="link">link</span>
                            DOI
                          </a>
                        )}
                        {publicacao.urlExterna && (
                          <a
                            href={publicacao.urlExterna}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-highest border border-outline-variant/30 text-[10px] font-black text-on-surface-variant uppercase tracking-widest hover:border-primary/50 hover:text-primary transition-all"
                          >
                            <span class="material-symbols-outlined text-sm" data-icon={publicacao.urlExterna.includes("/docs/publicacoes/") || publicacao.urlExterna.endsWith(".pdf") ? "picture_as_pdf" : "open_in_new"}>
                              {publicacao.urlExterna.includes("/docs/publicacoes/") || publicacao.urlExterna.endsWith(".pdf") ? "picture_as_pdf" : "open_in_new"}
                            </span>
                            {publicacao.urlExterna.includes("/docs/publicacoes/") || publicacao.urlExterna.endsWith(".pdf") ? "PDF" : "Acessar"}
                          </a>
                        )}
                      </div>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </section>
    )
  }

  {
    problemas.length > 0 && (
      <section class="mt-20 rounded-2xl bg-primary/5 p-6 border border-primary/30">
        <div class="flex items-center gap-3 text-primary mb-2">
          <span class="material-symbols-outlined" data-icon="report_problem">report_problem</span>
          <p class="text-xs font-black uppercase tracking-widest">Aviso de Validação</p>
        </div>
        <p class="text-sm text-on-surface-variant/90 leading-relaxed font-medium">
          {problemas.length} registro(s) de publicação foram ignorados por inconsistências de título ou ano. Estamos trabalhando para normalizar esses dados.
        </p>
      </section>
    )
  }

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const filtro = document.getElementById(
        "filtro-ano",
      ) as HTMLSelectElement | null;
      const secoes = document.querySelectorAll<HTMLElement>(".secao-ano");

      if (filtro) {
        filtro.addEventListener("change", (e) => {
          const anoSelecionado = (e.target as HTMLSelectElement).value;
          secoes.forEach((secao) => {
            if (
              anoSelecionado === "todos" ||
              secao.getAttribute("data-ano") === anoSelecionado
            ) {
              secao.style.display = "block";
            } else {
              secao.style.display = "none";
            }
          });
        });
      }
    });
  </script>
</BaseLayout>
