---
import { getCollection } from "astro:content";
import ProjectCards from "../../components/ProjectCards.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projetos = (await getCollection("projects"))
  .filter((projeto) => projeto.data.status === "Concluído")
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"));
---

<BaseLayout
  title="Projetos concluídos | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Projetos concluídos do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Trajetória Científica</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Concluídos</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/90 font-medium">
      O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
      registrou aqui os projetos concluídos para facilitar a consulta ao seu
      histórico de pesquisa e às frentes que já entregaram resultados.
    </p>
  </section>

  <ProjectCards
    projetos={projetos}
    vazio="Nenhum projeto concluído cadastrado no momento."
  />
</BaseLayout>
