---
import BaseLayout from "../layouts/BaseLayout.astro";

const fundadores = [
  {
    nome: "Fundação Hospital de Olhos",
    imagem: "/images/parceiros/fundacao-holhos.jpg",
  },
  { nome: "Universidade Federal de Minas Gerais - UFMG", imagem: "/images/parceiros/ufmg.jpg" },
  { nome: "Laboratório de Bio-engenharia - lab-bio", imagem: "/images/parceiros/labbio.jpg" },
];

const parceiros = [
  { nome: "Conselho Nacional de Desenvolvimento Científico e Tecnológico - CNPq", imagem: "/images/parceiros/cnpq.jpg" },
  { nome: "Bom Começo", imagem: "/images/parceiros/bom-comeco.jpg" },
  {
    nome: "Laboratório de Neurodinâmica da Visão - LANEV",
    imagem: "/images/parceiros/lanev_logo.png",
  },
];

const apoio = [
  { nome: "Fundação de Amparo à Pesquisa do Estado de Minas Gerais - FAPEMIG", imagem: "/images/parceiros/fapemig.jpg" },
  {
    nome: "Bill and Melinda Gates Foundation",
    imagem: "/images/parceiros/gates-foundation.jpg",
  },
];

const semCorte = new Set(["Laboratório de Neurodinâmica da Visão - LANEV"]);
const semBorda = new Set(["Laboratório de Neurodinâmica da Visão - LANEV"]);
---

<BaseLayout
  title="Parceiros | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Rede de fundadores, parceiros e apoiadores do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Rede de Colaboração</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Parceiros</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
      O LAPAN fundamenta sua atuação em uma rede sólida de cooperação institucional, unindo hospitais, universidades e fundações para o avanço da neurociência aplicada.
    </p>
  </section>

  <section class="pt-16 first:pt-0">
    <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Instituições Fundadoras</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        fundadores.map((item) => (
          <figure
            class="group overflow-hidden rounded-2xl bg-surface-container-low border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1 shadow-xl shadow-black/20"
          >
            <div class="relative overflow-hidden aspect-video bg-white/5 p-6">
              <img
                src={item.imagem}
                alt={item.nome}
                class={`h-full w-full transition-transform duration-500 group-hover:scale-105 ${
                  semCorte.has(item.nome)
                    ? "object-contain"
                    : "object-cover"
                }`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="px-6 py-5 text-sm font-bold text-on-surface leading-tight group-hover:text-primary transition-colors">
              {item.nome}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="pt-24">
    <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Parceiros de Pesquisa</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        parceiros.map((item) => (
          <figure
            class="group overflow-hidden rounded-2xl bg-surface-container-low border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1 shadow-xl shadow-black/20"
          >
            <div class="relative overflow-hidden aspect-video bg-white/5 p-6">
              <img
                src={item.imagem}
                alt={item.nome}
                class={`h-full w-full transition-transform duration-500 group-hover:scale-105 ${
                  semCorte.has(item.nome)
                    ? "object-contain"
                    : "object-cover"
                }`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="px-6 py-5 text-sm font-bold text-on-surface leading-tight group-hover:text-primary transition-colors">
              {item.nome}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="pt-24 pb-12">
    <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Fomento e Apoio</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        apoio.map((item) => (
          <figure
            class="group overflow-hidden rounded-2xl bg-surface-container-low border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1 shadow-xl shadow-black/20"
          >
            <div class="relative overflow-hidden aspect-video bg-white/5 p-6">
              <img
                src={item.imagem}
                alt={item.nome}
                class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="px-6 py-5 text-sm font-bold text-on-surface leading-tight group-hover:text-primary transition-colors">
              {item.nome}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</BaseLayout>
