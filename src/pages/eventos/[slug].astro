---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildEventSummary,
  formatDatePtBR,
  getEventAttendanceMode,
  getEventStatus,
} from "../../lib/content-helpers";
import { buildAbsoluteUrl, buildAssetUrl, getBaseUrl } from "../../lib/geo";
import { siteName } from "../../lib/site";

export async function getStaticPaths() {
  const eventos = await getCollection("events");

  return eventos.map((evento) => ({
    params: { slug: evento.id },
    props: { evento },
  }));
}

const { evento } = Astro.props;
const baseUrl = getBaseUrl(Astro.site);
const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
const resumo = buildEventSummary(evento.data);
const image = evento.data.imagem
  ? buildAssetUrl(evento.data.imagem, baseUrl)
  : undefined;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "@id": `${canonicalUrl}#event`,
    url: canonicalUrl,
    name: evento.data.titulo,
    description: resumo,
    startDate: evento.data.data.toISOString(),
    endDate: (evento.data.fim ?? evento.data.data).toISOString(),
    eventAttendanceMode: getEventAttendanceMode(evento.data.modo),
    eventStatus: getEventStatus(evento.data.data, evento.data.fim),
    image: image ? [image] : undefined,
    organizer:
      evento.data.organizadores.length > 0
        ? evento.data.organizadores.map((organizador) => ({
            "@type": "Organization",
            name: organizador,
          }))
        : [
            {
              "@type": "Organization",
              name: siteName,
              url: baseUrl.toString(),
            },
          ],
    location: {
      "@type": "Place",
      name: evento.data.local,
      address: evento.data.local,
    },
    performer: evento.data.instituicoes.map((instituicao) => ({
      "@type": "Organization",
      name: instituicao,
    })),
  },
];
---

<BaseLayout
  title={`${evento.data.titulo} | Eventos LAPAN`}
  description={resumo}
  image={evento.data.imagem}
  pageType="article"
  breadcrumbs={[
    { name: "Início", item: "/" },
    { name: "Eventos", item: "/eventos/" },
    { name: evento.data.titulo },
  ]}
  structuredData={structuredData}
>
  <section class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
    <div class="animate-on-scroll">
      <div class="flex items-center gap-3 mb-6">
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase border border-primary/30">
          {evento.data.tipo ?? "Evento acadêmico"}
        </span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80">{evento.data.modo}</span>
      </div>

      <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight mb-8">{evento.data.titulo}</h1>
      
      <div class="prose prose-invert max-w-none">
        <p class="text-xl leading-relaxed text-on-surface-variant/90 font-medium mb-6">
          {resumo}
        </p>
        <p class="text-base leading-relaxed text-on-surface-variant/80">
          {evento.data.descricao}
        </p>
      </div>

      {evento.data.link && (
        <div class="mt-10">
          <a
            href={evento.data.link}
            target="_blank"
            rel="noreferrer"
            class="btn-primary text-xs uppercase tracking-widest py-4 px-8 inline-flex items-center gap-2"
          >
            Acessar Site do Evento
            <span class="material-symbols-outlined text-sm" data-icon="open_in_new">open_in_new</span>
          </a>
        </div>
      )}
    </div>

    <aside class="animate-on-scroll delay-200">
      <div class="rounded-3xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-2xl shadow-black/40">
        <h2 class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-8">Informações Técnicas</h2>
        <dl class="space-y-8">
          <div class="flex gap-4">
            <span class="material-symbols-outlined text-primary" data-icon="event">event</span>
            <div>
              <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80 mb-1">Data e Período</dt>
              <dd class="text-sm font-bold text-on-surface">
                {formatDatePtBR(evento.data.data)}
                {evento.data.fim && <span class="mx-2 opacity-30">—</span>}
                {evento.data.fim && formatDatePtBR(evento.data.fim)}
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="material-symbols-outlined text-primary" data-icon="location_on">location_on</span>
            <div>
              <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80 mb-1">Localização</dt>
              <dd class="text-sm font-bold text-on-surface">{evento.data.local}</dd>
            </div>
          </div>

          {evento.data.publico && (
            <div class="flex gap-4">
              <span class="material-symbols-outlined text-primary" data-icon="groups">groups</span>
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80 mb-1">Público-alvo</dt>
                <dd class="text-sm font-bold text-on-surface">{evento.data.publico}</dd>
              </div>
            </div>
          )}

          {evento.data.organizadores.length > 0 && (
            <div class="flex gap-4">
              <span class="material-symbols-outlined text-primary" data-icon="corporate_fare">corporate_fare</span>
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/80 mb-1">Organização</dt>
                <dd class="text-sm font-bold text-on-surface leading-relaxed">{evento.data.organizadores.join(", ")}</dd>
              </div>
            </div>
          )}
        </dl>
      </div>
    </aside>
  </section>

  {evento.data.imagem && (
    <section class="pt-24 animate-on-scroll">
      <figure class="relative overflow-hidden rounded-[2rem] border border-outline-variant/30 bg-surface-container-low shadow-2xl group">
        <img
          src={evento.data.imagem}
          alt={`Imagem do evento ${evento.data.titulo}`}
          class="w-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/60 via-transparent to-transparent"></div>
      </figure>
    </section>
  )}

  {(evento.data.instituicoes.length > 0 || evento.data.temas.length > 0) && (
    <section class="pt-24 grid gap-8 lg:grid-cols-2">
      {evento.data.instituicoes.length > 0 && (
        <article class="rounded-3xl bg-surface-container-low p-10 border border-outline-variant/30">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Instituições e Parceiros</h2>
          <ul class="space-y-4">
            {evento.data.instituicoes.map((item) => (
              <li class="flex items-center gap-3 text-on-surface-variant/80">
                <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
                <span class="text-base font-medium">{item}</span>
              </li>
            ))}
          </ul>
        </article>
      )}
      {evento.data.temas.length > 0 && (
        <article class="rounded-3xl bg-surface-container-low p-10 border border-outline-variant/30">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Eixos Temáticos</h2>
          <ul class="flex flex-wrap gap-3">
            {evento.data.temas.map((tema) => (
              <li class="rounded-lg bg-surface-container-high border border-outline-variant/30 px-4 py-2 text-xs font-black uppercase tracking-widest text-primary">
                {tema}
              </li>
            ))}
          </ul>
        </article>
      )}
    </section>
  )}
</BaseLayout>
