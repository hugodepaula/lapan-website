---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildEventSummary, buildProjectSummary } from "../lib/content-helpers";
import { impactosMissao, missaoCurta } from "../lib/identidade";

const todosProjetos = await getCollection("projects");
const todosEventos = await getCollection("events");
const todaEquipe = await getCollection("team");

const projetos = todosProjetos.slice(0, 3);
const eventos = [...todosEventos]
  .sort(
    (a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime(),
  )
  .slice(0, 3);

const metricas = [
  {
    rotulo: "Projetos cadastrados",
    valor: todosProjetos.length > 0 ? String(todosProjetos.length) : "+30",
  },
  {
    rotulo: "Eventos cadastrados",
    valor: todosEventos.length > 0 ? String(todosEventos.length) : "+20",
  },
  {
    rotulo: "Membros cadastrados",
    valor: todaEquipe.length > 0 ? String(todaEquipe.length) : "+15",
  },
];
---

<BaseLayout
  title="Início | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Laboratório acadêmico com atuação em pesquisa aplicada, formação e extensão."
>
  <section
    class="relative overflow-hidden rounded-3xl border border-brand-200 bg-[url('/images/hero/hero_bg.jpg')] bg-cover bg-center p-6 shadow-soft sm:p-8 lg:p-12"
  >
    <div class="absolute inset-0 bg-surface/85 backdrop-blur-[2px]"></div>

    <div
      class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent-100/60 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-20 left-0 h-48 w-48 rounded-full bg-brand-100/60 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div class="animate-on-scroll">
        <p
          class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700"
        >
          Pesquisa aplicada em neurociência da visão
        </p>
        <h1
          class="mt-3 text-4xl leading-tight sm:text-5xl bg-clip-text text-transparent bg-gradient-to-r from-brand-900 via-brand-700 to-accent-600"
        >
          Produzimos ciência confiável para decisões reais.
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-700">
          O Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)
          integra pesquisa, ensino e extensão em um ecossistema acadêmico
          contemporâneo, com foco em método, clareza e impacto social.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/projetos"
            class="inline-flex items-center rounded-md bg-accent-500 px-5 py-2.5 text-sm font-semibold text-surface transition duration-200 hover:bg-accent-600"
          >
            Explorar projetos
          </a>
          <a
            href="/eventos"
            class="inline-flex items-center rounded-md border border-brand-200 bg-accent-500/15 px-5 py-2.5 text-sm font-semibold text-accent-800 transition duration-200 hover:border-brand-400 hover:bg-accent-500/25"
          >
            Ver agenda de eventos
          </a>
          <a
            href="/equipe"
            class="inline-flex items-center rounded-md border border-brand-200 bg-surface px-5 py-2.5 text-sm font-semibold text-brand-700 transition duration-200 hover:border-brand-400 hover:bg-brand-50"
          >
            Conheça a equipe
          </a>
        </div>
      </div>

      <aside
        class="animate-on-scroll delay-200 rounded-2xl border border-brand-200 bg-surface/60 backdrop-blur-sm p-6 shadow-sm"
      >
        <p class="text-xs uppercase tracking-[0.1em] text-brand-600">
          Indicadores
        </p>
        <dl class="mt-4 space-y-4" id="indicadores-container">
          {
            metricas.map((item) => {
              const num = parseInt(item.valor.replace(/\D/g, ""));
              const isPlus = item.valor.includes("+");
              return (
                <div class="border-b border-brand-200 pb-3 last:border-0 last:pb-0">
                  <dt class="text-sm text-neutral-700">{item.rotulo}</dt>
                  <dd class="mt-1 text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-brand-900 to-accent-700">
                    {isPlus && "+"}
                    <span class="contador" data-target={num}>
                      0
                    </span>
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </aside>
    </div>
  </section>

  <section class="pt-10">
    <div class="grid gap-6 rounded-3xl border border-brand-200 bg-surface p-6 shadow-soft lg:grid-cols-[1fr_1.1fr] lg:p-8">
      <div class="animate-on-scroll">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">
          O que fazemos e por que importa
        </p>
        <h2 class="mt-3 text-3xl leading-tight text-brand-900">
          {missaoCurta}
        </h2>
        <a
          href="/sobre-o-laboratorio/missao-e-valores"
          class="mt-5 inline-flex items-center text-sm font-semibold text-accent-700 transition duration-200 hover:text-accent-600"
        >
          Conheça a missão e valores
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {
          impactosMissao.map((impacto, index) => (
            <article
              class={`animate-on-scroll rounded-2xl border border-brand-200 bg-brand-50/60 p-5 transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-soft ${
                index === 1 ? "delay-100" : index === 2 ? "delay-200" : ""
              }`}
            >
              <p class="text-sm leading-relaxed text-neutral-700">{impacto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="projetos" class="pt-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl text-brand-900">Projetos</h2>
      <a
        href="/projetos"
        class="text-sm font-semibold text-accent-700 transition hover:text-accent-600"
        >Ver todos</a
      >
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        projetos.length > 0 ? (
          projetos.map((projeto, i) => (
            <article
              class={`animate-on-scroll rounded-2xl border border-brand-200 bg-surface/80 backdrop-blur-sm p-6 shadow-soft transition-all duration-300 hover:-translate-y-2 hover:shadow-premium-hover hover:border-brand-300 group ${
                i === 1 ? "delay-100" : i === 2 ? "delay-200" : ""
              }`}
            >
              <h3 class="text-xl text-brand-900 transition-colors group-hover:text-accent-600">
                <a href={`/projetos/${projeto.id}/`} class="hover:underline">
                  {projeto.data.titulo}
                </a>
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">
                {buildProjectSummary(projeto.data)}
              </p>
              <a
                href={`/projetos/${projeto.id}/`}
                class="mt-4 inline-flex text-sm font-semibold text-accent-700 transition hover:text-accent-600"
              >
                Ver projeto
              </a>
            </article>
          ))
        ) : (
          <p class="text-neutral-700 md:col-span-3">
            Nenhum projeto cadastrado no momento.
          </p>
        )
      }
    </div>
  </section>

  <section id="eventos" class="pt-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl text-brand-900">Eventos</h2>
      <a
        href="/eventos"
        class="text-sm font-semibold text-accent-700 transition hover:text-accent-600"
        >Ver agenda completa</a
      >
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        eventos.length > 0 ? (
          eventos.map((evento, i) => (
            <article
              class={`animate-on-scroll rounded-2xl border border-brand-200 bg-surface/80 backdrop-blur-sm p-6 shadow-soft transition-all duration-300 hover:-translate-y-2 hover:shadow-premium-hover hover:border-brand-300 group ${
                i === 1 ? "delay-100" : i === 2 ? "delay-200" : ""
              }`}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-700">
                {new Intl.DateTimeFormat("pt-BR", {
                  day: "2-digit",
                  month: "short",
                  year: "numeric",
                }).format(new Date(evento.data.data))}
              </p>
              <h3 class="mt-3 text-xl text-brand-900 transition-colors group-hover:text-accent-600">
                <a href={`/eventos/${evento.id}/`} class="hover:underline">
                  {evento.data.titulo}
                </a>
              </h3>
              <p class="mt-2 text-sm font-semibold text-neutral-700">
                {evento.data.local}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">
                {buildEventSummary(evento.data)}
              </p>
              <a
                href={`/eventos/${evento.id}/`}
                class="mt-4 inline-flex text-sm font-semibold text-accent-700 transition hover:text-accent-600"
              >
                Ver evento
              </a>
            </article>
          ))
        ) : (
          <p class="text-neutral-700 md:col-span-3">
            Nenhum evento cadastrado no momento.
          </p>
        )
      }
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const counters = document.querySelectorAll(".contador");

      /** @param {HTMLElement} el */
      const animateCounter = (el) => {
        const target = +el.getAttribute("data-target");
        if (!target) return;
        const duration = 2000;
        const stepTime = Math.max(Math.floor(duration / target), 10);
        let current = 0;

        const timer = setInterval(() => {
          current += Math.ceil(target / (duration / stepTime));
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }
          el.innerText = current;
        }, stepTime);
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px", threshold: 0.5 },
      );

      counters.forEach((counter) => observer.observe(counter));
    });
  </script>
</BaseLayout>
