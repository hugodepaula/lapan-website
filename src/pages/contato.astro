---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildAbsoluteUrl, getBaseUrl } from "../lib/geo";
import { valoresInstitucionais } from "../lib/identidade";
import { contactEmail, contactPhone, siteName } from "../lib/site";

const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? "";
const email = contactEmail;
const valoresParceria = valoresInstitucionais.filter((valor) =>
  [
    "Transparência e ciência aberta",
    "Ética e respeito às pessoas",
    "Colaboração e serviço público",
  ].includes(valor.titulo),
);
const baseUrl = getBaseUrl(Astro.site);
const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: `Contato | ${siteName}`,
    description:
      "Página de contato institucional do LAPAN com endereço, escopo de atendimento, telefone e e-mail.",
    mainEntity: {
      "@type": "Organization",
      "@id": `${baseUrl.toString()}#organization`,
      name: siteName,
      email,
      telephone: contactPhone,
    },
  },
];
---

<BaseLayout
  title="Contato | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Página de contato institucional do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
  structuredData={structuredData}
>
  <section class="grid gap-12 xl:grid-cols-[0.9fr_1.1fr] xl:items-start">
    <div class="animate-on-scroll">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Fale conosco</p>
      <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Contato</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
        Entre em contato com o Laboratório de Pesquisa Aplicada à
        Neurociências da Visão (LAPAN) para informações institucionais,
        parcerias e demandas de imprensa.
      </p>

      <div class="mt-12 space-y-6">
        <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/10 shadow-xl shadow-black/20">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary" data-icon="location_on">location_on</span>
            <h2 class="text-xl font-bold text-on-surface">Localização</h2>
          </div>
          <address class="not-italic text-base leading-relaxed text-on-surface-variant/80">
            Rua da Paisagem, 220 - Vila da Serra<br />
            Belo Horizonte - MG, CEP 30720-600<br />
            Brasil
          </address>
        </div>

        <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-xl shadow-black/20">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary" data-icon="alternate_email">alternate_email</span>
            <h2 class="text-xl font-bold text-on-surface">Canais Diretos</h2>
          </div>
          <div class="space-y-4">
            <div class="flex flex-col">
              <span class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/80 mb-1">Telefone Institucional</span>
              <p class="text-lg font-bold text-on-surface">{contactPhone}</p>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/80 mb-1">E-mail de Contato</span>
              <a href={`mailto:${email}`} class="text-lg font-bold text-primary hover:text-primary-light transition-colors">{email}</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 overflow-hidden rounded-3xl border border-outline-variant/30 bg-surface-container-low shadow-2xl">
        <iframe
          title="Mapa do endereço do laboratório"
          src="https://www.google.com/maps?q=Rua+da+Paisagem,+220,+Vila+da+Serra,+Belo+Horizonte,+MG,+30720-600&output=embed"
          class="h-[400px] w-full opacity-90"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <div class="animate-on-scroll delay-200">
      <div class="rounded-3xl bg-surface-container-low p-8 lg:p-12 border border-outline-variant/30 shadow-2xl shadow-black/40">
        <div class="flex items-center gap-3 mb-8">
          <span class="material-symbols-outlined text-primary" data-icon="send">send</span>
          <h2 class="text-3xl font-bold text-on-surface tracking-tight">Envie sua mensagem</h2>
        </div>
        
        <p class="mb-10 text-on-surface-variant/90 leading-relaxed italic">
          Utilize o formulário abaixo para solicitações acadêmicas, parcerias ou contatos de imprensa. Nossa equipe responderá em breve.
        </p>

        <form
          id="contato-form"
          class="space-y-8"
          method="post"
          action={formEndpoint || "#"}
          data-endpoint={formEndpoint}
          data-fallback-email={email}
          novalidate
        >
          <input type="hidden" name="_subject" value="Contato pelo site do LAPAN" />

          <div class="space-y-2">
            <label for="your-name" class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/90">Nome Completo</label>
            <input
              id="your-name"
              name="your-name"
              type="text"
              autocomplete="name"
              required
              class="w-full bg-surface-container-highest border-b-2 border-outline-variant/50 px-0 py-3 text-on-surface transition-all focus:outline-none focus:border-primary placeholder:text-on-surface-variant/60"
              placeholder="Como gostaria de ser chamado?"
            />
          </div>

          <div class="space-y-2">
            <label for="your-email" class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/90">E-mail Institucional</label>
            <input
              id="your-email"
              name="your-email"
              type="email"
              autocomplete="email"
              required
              class="w-full bg-surface-container-highest border-b-2 border-outline-variant/50 px-0 py-3 text-on-surface transition-all focus:outline-none focus:border-primary placeholder:text-on-surface-variant/60"
              placeholder="seu.nome@instituicao.edu"
            />
          </div>

          <div class="space-y-2">
            <label for="your-subject" class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/90">Assunto</label>
            <input
              id="your-subject"
              name="your-subject"
              type="text"
              required
              class="w-full bg-surface-container-highest border-b-2 border-outline-variant/50 px-0 py-3 text-on-surface transition-all focus:outline-none focus:border-primary placeholder:text-on-surface-variant/60"
              placeholder="Ex: Parceria de Pesquisa"
            />
          </div>

          <div class="space-y-2">
            <label for="your-message" class="text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/90">Mensagem</label>
            <textarea
              id="your-message"
              name="your-message"
              rows="5"
              required
              maxlength="2000"
              class="w-full bg-surface-container-highest border-b-2 border-outline-variant/50 px-0 py-3 text-on-surface transition-all focus:outline-none focus:border-primary placeholder:text-on-surface-variant/60 resize-none"
              placeholder="Como podemos ajudar?"
            ></textarea>
          </div>


          <div id="form-status-container" class="hidden">
             <p id="form-status" class="text-sm font-bold uppercase tracking-widest p-4 rounded-xl" aria-live="polite"></p>
          </div>

          <button
            type="submit"
            class="btn-primary w-full py-4 uppercase tracking-[0.2em] text-xs flex justify-center items-center gap-2"
          >
            Enviar Mensagem
            <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
          </button>
        </form>
      </div>

      <div class="mt-12 p-8 bg-primary/5 rounded-3xl border border-primary/10">
        <h2 class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-6">Como trabalhamos</h2>
        <div class="space-y-6">
          {valoresParceria.map((valor) => (
            <article>
              <h3 class="text-sm font-bold text-on-surface mb-2">{valor.titulo}</h3>
              <p class="text-sm leading-relaxed text-on-surface-variant/70">{valor.descricao}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector("#contato-form");
    const statusContainer = document.querySelector("#form-status-container");
    const status = document.querySelector("#form-status");

    if (form && status && statusContainer) {
      form.addEventListener("submit", async (event) => {
        const endpoint = form.getAttribute("data-endpoint");
        const fallbackEmail = form.getAttribute("data-fallback-email");
        
        statusContainer.classList.remove("hidden");

        if (!endpoint) {
          event.preventDefault();
          status.textContent = `Envio online pendente. Use: ${fallbackEmail}.`;
          status.className = "text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 p-4 rounded-xl";
          return;
        }

        if (!form.reportValidity()) {
          event.preventDefault();
          status.textContent = "Revise os campos obrigatórios.";
          status.className = "text-xs font-bold uppercase tracking-widest text-red-400 bg-red-400/10 p-4 rounded-xl";
          return;
        }

        event.preventDefault();
        status.textContent = "Transmitindo...";
        status.className = "text-xs font-bold uppercase tracking-widest text-on-surface-variant bg-surface-container-high p-4 rounded-xl";

        const formData = new FormData(form);
        const data = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          data.append(key, String(value));
        }

        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded",
            },
            body: data.toString(),
          });

          if (!response.ok) {
            throw new Error("Falha no envio");
          }

          form.reset();
          status.textContent = "Transmitido com sucesso.";
          status.className = "text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 p-4 rounded-xl";
        } catch {
          status.textContent = `Falha na transmissão. Use ${fallbackEmail}.`;
          status.className = "text-xs font-bold uppercase tracking-widest text-red-400 bg-red-400/10 p-4 rounded-xl";
        }
      });
    }
  </script>
</BaseLayout>
