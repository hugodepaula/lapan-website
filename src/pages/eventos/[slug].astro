---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildEventSummary,
  formatDatePtBR,
  getEventAttendanceMode,
  getEventStatus,
} from "../../lib/content-helpers";
import { buildAbsoluteUrl, buildAssetUrl, getBaseUrl } from "../../lib/geo";
import { siteName } from "../../lib/site";

export async function getStaticPaths() {
  const eventos = await getCollection("events");

  return eventos.map((evento) => ({
    params: { slug: evento.id },
    props: { evento },
  }));
}

const { evento } = Astro.props;
const baseUrl = getBaseUrl(Astro.site);
const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
const resumo = buildEventSummary(evento.data);
const image = evento.data.imagem
  ? buildAssetUrl(evento.data.imagem, baseUrl)
  : undefined;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "@id": `${canonicalUrl}#event`,
    url: canonicalUrl,
    name: evento.data.titulo,
    description: resumo,
    startDate: evento.data.data.toISOString(),
    endDate: (evento.data.fim ?? evento.data.data).toISOString(),
    eventAttendanceMode: getEventAttendanceMode(evento.data.modo),
    eventStatus: getEventStatus(evento.data.data, evento.data.fim),
    image: image ? [image] : undefined,
    organizer:
      evento.data.organizadores.length > 0
        ? evento.data.organizadores.map((organizador) => ({
            "@type": "Organization",
            name: organizador,
          }))
        : [
            {
              "@type": "Organization",
              name: siteName,
              url: baseUrl.toString(),
            },
          ],
    location: {
      "@type": "Place",
      name: evento.data.local,
      address: evento.data.local,
    },
    performer: evento.data.instituicoes.map((instituicao) => ({
      "@type": "Organization",
      name: instituicao,
    })),
  },
];
---

<BaseLayout
  title={`${evento.data.titulo} | Eventos LAPAN`}
  description={resumo}
  image={evento.data.imagem}
  pageType="article"
  breadcrumbs={[
    { name: "Início", item: "/" },
    { name: "Eventos", item: "/eventos/" },
    { name: evento.data.titulo },
  ]}
  structuredData={structuredData}
>
  <section class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">Evento</p>
      <h1 class="mt-3 text-4xl text-brand-900 sm:text-5xl">{evento.data.titulo}</h1>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-700">
          {evento.data.tipo ?? "Evento acadêmico"}
        </span>
        <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
          {evento.data.modo}
        </span>
      </div>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-neutral-700">
        {resumo}
      </p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
        {evento.data.descricao}
      </p>
      {evento.data.link && (
        <a
          href={evento.data.link}
          target="_blank"
          rel="noreferrer"
          class="mt-6 inline-flex rounded-md bg-accent-500 px-4 py-2 text-sm font-semibold text-surface transition hover:bg-accent-600"
        >
          Acessar link do evento
        </a>
      )}
    </div>

    <aside class="rounded-3xl border border-brand-200 bg-surface p-6 shadow-soft">
      <h2 class="text-2xl text-brand-900">Informações principais</h2>
      <dl class="mt-5 space-y-4 text-sm text-neutral-700">
        <div>
          <dt class="font-semibold text-brand-900">Data</dt>
          <dd>
            {formatDatePtBR(evento.data.data)}
            {evento.data.fim && ` até ${formatDatePtBR(evento.data.fim)}`}
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-brand-900">Local</dt>
          <dd>{evento.data.local}</dd>
        </div>
        {evento.data.publico && (
          <div>
            <dt class="font-semibold text-brand-900">Público</dt>
            <dd>{evento.data.publico}</dd>
          </div>
        )}
        {evento.data.organizadores.length > 0 && (
          <div>
            <dt class="font-semibold text-brand-900">Organização</dt>
            <dd>{evento.data.organizadores.join(", ")}</dd>
          </div>
        )}
      </dl>
    </aside>
  </section>

  {evento.data.imagem && (
    <section class="pt-10">
      <figure class="overflow-hidden rounded-3xl border border-brand-200 bg-surface shadow-soft">
        <img
          src={evento.data.imagem}
          alt={`Imagem do evento ${evento.data.titulo}`}
          class="w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  )}

  {(evento.data.instituicoes.length > 0 || evento.data.temas.length > 0) && (
    <section class="pt-12 grid gap-4 lg:grid-cols-2">
      {evento.data.instituicoes.length > 0 && (
        <article class="rounded-2xl border border-brand-200 bg-surface p-6 shadow-soft">
          <h2 class="text-2xl text-brand-900">Instituições e parceiros</h2>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700">
            {evento.data.instituicoes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      )}
      {evento.data.temas.length > 0 && (
        <article class="rounded-2xl border border-brand-200 bg-surface p-6 shadow-soft">
          <h2 class="text-2xl text-brand-900">Temas centrais</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {evento.data.temas.map((tema) => (
              <li class="rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">
                {tema}
              </li>
            ))}
          </ul>
        </article>
      )}
    </section>
  )}
</BaseLayout>
