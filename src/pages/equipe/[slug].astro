---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import publicacoesBrutas from "../../../content/zotero.json";
import { buildPersonSummary, buildProjectSummary } from "../../lib/content-helpers";
import { matchesAuthorName } from "../../lib/entities";
import { buildAbsoluteUrl, buildAssetUrl, getBaseUrl } from "../../lib/geo";
import { normalizarPublicacoes } from "../../lib/publicacoes";
import { siteName } from "../../lib/site";

export async function getStaticPaths() {
  const membros = await getCollection("team");

  return membros.map((membro) => ({
    params: { slug: membro.id },
    props: { membro },
  }));
}

const { membro } = Astro.props;
const projetos = await getCollection("projects");
const relacionados = projetos
  .filter((projeto) => projeto.data.equipe.includes(membro.id))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"));

const { publicacoes } = normalizarPublicacoes(publicacoesBrutas);
const publicacoesRelacionadas = publicacoes
  .filter((publicacao) => matchesAuthorName(membro.data.nome, publicacao.autores))
  .slice(0, 10);

const resumo = buildPersonSummary(membro.data);
const baseUrl = getBaseUrl(Astro.site);
const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
const image = membro.data.foto
  ? buildAssetUrl(membro.data.foto, baseUrl)
  : undefined;
const sameAs = [
  ...membro.data.links.map((link) => link.url),
  ...(membro.data.orcid ? [membro.data.orcid] : []),
].filter(Boolean);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: `${membro.data.nome} | Equipe ${siteName}`,
    description: resumo,
    mainEntity: {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      name: membro.data.nome,
      description: resumo,
      image,
      email: membro.data.email,
      jobTitle: membro.data.cargo,
      worksFor: {
        "@id": `${baseUrl.toString()}#organization`,
      },
      affiliation: membro.data.afiliacao
        ? {
            "@type": "Organization",
            name: membro.data.afiliacao,
          }
        : undefined,
      sameAs,
      knowsAbout: membro.data.areasAtuacao,
    },
  },
];
---

<BaseLayout
  title={`${membro.data.nome} | Equipe LAPAN`}
  description={resumo}
  image={membro.data.foto}
  pageType="profile"
  breadcrumbs={[
    { name: "Início", item: "/" },
    { name: "Equipe", item: "/equipe/" },
    { name: membro.data.nome },
  ]}
  structuredData={structuredData}
>
  <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div class="rounded-3xl border border-brand-200 bg-surface p-6 shadow-soft">
      <img
        src={membro.data.foto || "/images/logo_squared.png"}
        alt={`Foto de ${membro.data.nome}`}
        class="aspect-[4/5] w-full rounded-2xl border border-brand-200 bg-brand-50 p-3 object-contain"
        loading="lazy"
        decoding="async"
      />
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-700">
          {membro.data.tipo}
        </span>
        {membro.data.afiliacao && (
          <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
            {membro.data.afiliacao}
          </span>
        )}
      </div>
      {(membro.data.links.length > 0 || membro.data.email) && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {membro.data.email && (
            <li>
              <a
                href={`mailto:${membro.data.email}`}
                class="inline-flex rounded-md border border-brand-200 px-2.5 py-1 text-xs font-semibold text-brand-700 transition hover:border-brand-400 hover:bg-brand-50"
              >
                E-mail
              </a>
            </li>
          )}
          {membro.data.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noreferrer"
                class="inline-flex rounded-md border border-brand-200 px-2.5 py-1 text-xs font-semibold text-brand-700 transition hover:border-brand-400 hover:bg-brand-50"
              >
                {link.rotulo}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-700">Equipe</p>
      <h1 class="mt-3 text-4xl text-brand-900 sm:text-5xl">{membro.data.nome}</h1>
      <p class="mt-3 text-lg font-semibold text-accent-700">{membro.data.cargo}</p>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-neutral-700">
        {resumo}
      </p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
        {membro.data.bio}
      </p>

      {membro.data.credenciais.length > 0 && (
        <section class="pt-8">
          <h2 class="text-2xl text-brand-900">Credenciais e formação</h2>
          <ul class="mt-4 grid gap-2 text-sm text-neutral-700 sm:grid-cols-2">
            {membro.data.credenciais.map((item) => (
              <li class="rounded-xl border border-brand-200 bg-surface px-4 py-3 shadow-soft">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )}

      {membro.data.areasAtuacao.length > 0 && (
        <section class="pt-8">
          <h2 class="text-2xl text-brand-900">Áreas de atuação</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {membro.data.areasAtuacao.map((area) => (
              <li class="rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">
                {area}
              </li>
            ))}
          </ul>
        </section>
      )}

      {membro.data.destaques.length > 0 && (
        <section class="pt-8">
          <h2 class="text-2xl text-brand-900">Destaques</h2>
          <ul class="mt-4 space-y-3">
            {membro.data.destaques.map((item) => (
              <li class="rounded-2xl border border-brand-200 bg-surface p-4 text-sm leading-relaxed text-neutral-700 shadow-soft">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>

  <section class="pt-12">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl text-brand-900">Projetos relacionados</h2>
      <p class="text-sm text-neutral-700">{relacionados.length} projeto(s)</p>
    </div>
    {relacionados.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-brand-200 bg-surface p-6">
        <p class="text-neutral-700">
          Ainda não há projetos vinculados diretamente a este perfil.
        </p>
      </div>
    ) : (
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {relacionados.map((projeto) => (
          <article class="rounded-2xl border border-brand-200 bg-surface p-5 shadow-soft">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-700">
              {projeto.data.status}
            </p>
            <h3 class="mt-2 text-xl text-brand-900">
              <a
                href={`/projetos/${projeto.id}/`}
                class="transition hover:text-accent-700 hover:underline"
              >
                {projeto.data.titulo}
              </a>
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">
              {buildProjectSummary(projeto.data)}
            </p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="pt-12">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl text-brand-900">Publicações relacionadas</h2>
      <p class="text-sm text-neutral-700">
        {publicacoesRelacionadas.length} publicação(ões)
      </p>
    </div>
    {publicacoesRelacionadas.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-brand-200 bg-surface p-6">
        <p class="text-neutral-700">
          Não foi possível vincular publicações automaticamente a este perfil com os metadados atuais.
        </p>
      </div>
    ) : (
      <div class="mt-6 space-y-4">
        {publicacoesRelacionadas.map((publicacao) => (
          <article class="rounded-2xl border border-brand-200 bg-surface p-5 shadow-soft">
            <p class="text-sm leading-relaxed text-neutral-800">
              {publicacao.referenciaAbnt}
            </p>
            {(publicacao.doiUrl || publicacao.urlExterna) && (
              <p class="mt-3 text-sm text-neutral-700">
                <span class="font-semibold text-brand-800">Acesso:</span>{" "}
                {publicacao.doiUrl && (
                  <a
                    href={publicacao.doiUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="font-semibold text-accent-700 transition hover:text-accent-600"
                  >
                    DOI
                  </a>
                )}
                {publicacao.doiUrl && publicacao.urlExterna && (
                  <span class="text-neutral-400"> | </span>
                )}
                {publicacao.urlExterna && (
                  <a
                    href={publicacao.urlExterna}
                    target="_blank"
                    rel="noreferrer"
                    class="font-semibold text-accent-700 transition hover:text-accent-600"
                  >
                    {publicacao.urlExterna.endsWith(".pdf") ? "PDF" : "URL externa"}
                  </a>
                )}
              </p>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
