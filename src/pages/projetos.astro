---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projetos = await getCollection("projects");
const emAndamento = projetos.filter((projeto) => projeto.data.status === "Em andamento");
const concluidos = projetos.filter((projeto) => projeto.data.status === "Concluído");
---

<BaseLayout
  title="Projetos | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Visão geral dos projetos do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Linhas de Atuação</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Projetos</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
      Os projetos do Laboratório de Pesquisa Aplicada à Neurociências da
      Visão (LAPAN) foram organizados para transformar perguntas de pesquisa em
      respostas aplicáveis ao cuidado, à leitura e à aprendizagem. Nesta área,
      você pode navegar entre os estudos em andamento e os já concluídos.
    </p>
  </section>

  <section class="grid gap-8 md:grid-cols-2">
    <article class="group rounded-2xl bg-surface-container-low p-8 border border-outline-variant/10 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1">
      <div class="flex items-center justify-between mb-6">
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase border border-primary/20">
          {emAndamento.length} projeto(s)
        </span>
        <span class="material-symbols-outlined text-primary/40 group-hover:text-primary transition-colors" data-icon="pending">pending</span>
      </div>
      
      <h2 class="text-3xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight">Em andamento</h2>
      <p class="mt-4 text-base leading-relaxed text-on-surface-variant/70">
        Pesquisas em curso que seguem gerando dados, instrumentos e aplicações com foco em avaliação, leitura e saúde visual.
      </p>
      
      <div class="mt-8">
        <a href="/projetos/em-andamento" class="btn-primary text-xs uppercase tracking-widest py-3 px-6">
          Ver projetos ativos →
        </a>
      </div>
    </article>

    <article class="group rounded-2xl bg-surface-container-low p-8 border border-outline-variant/10 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1">
      <div class="flex items-center justify-between mb-6">
        <span class="bg-on-surface-variant/10 text-on-surface-variant/60 px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase border border-outline-variant/20">
          {concluidos.length} projeto(s)
        </span>
        <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors" data-icon="task_alt">task_alt</span>
      </div>
      
      <h2 class="text-3xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight">Concluídos</h2>
      <p class="mt-4 text-base leading-relaxed text-on-surface-variant/70">
        Projetos já finalizados, com resultados que ajudam a compreender o histórico de pesquisa e os entregáveis produzidos pelo laboratório.
      </p>
      
      <div class="mt-8">
        <a href="/projetos/concluidos" class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 px-6 py-3 text-xs font-bold uppercase tracking-widest text-on-surface-variant transition hover:border-primary/50 hover:text-primary hover:bg-primary/5">
          Ver histórico →
        </a>
      </div>
    </article>
  </section>
</BaseLayout>
