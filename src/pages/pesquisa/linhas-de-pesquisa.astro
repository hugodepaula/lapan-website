---
import BaseLayout from "../../layouts/BaseLayout.astro";

const linhasPesquisa = [
  {
    titulo: "Leitura com conforto e menos fadiga",
    descricao:
      "Essa linha investigou como luz, contraste e estímulos visuais influenciam a leitura e testou ferramentas para reduzir desconforto visual em crianças e adultos.",
  },
  {
    titulo: "Movimentos oculares e desempenho funcional",
    descricao:
      "Os estudos analisaram como os olhos acompanham textos, números e tarefas do dia a dia para reconhecer sinais que podem afetar leitura, atenção e coordenação visual.",
  },
  {
    titulo: "Diagnóstico mais objetivo",
    descricao:
      "A equipe desenvolveu e validou equipamentos e métodos para tornar a avaliação visual mais precisa, comparável e útil na prática clínica e educacional.",
  },
];
---

<BaseLayout
  title="Linhas de pesquisa | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Linhas de pesquisa do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Agenda Científica</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Linhas de Pesquisa</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/80">
      O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
      estruturou sua agenda científica em frentes voltadas a problemas concretos
      de leitura, percepção e avaliação visual. Em comum, todas buscaram gerar
      evidências úteis para o cuidado e para a aprendizagem.
    </p>
  </section>

  <section class="pb-12 grid gap-6 md:grid-cols-3">
    {linhasPesquisa.map((linha) => (
      <article class="group card-tonal border border-outline-variant/30 p-8">
        <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/30 flex items-center justify-center mb-6 group-hover:bg-primary transition-colors">
          <span class="material-symbols-outlined text-primary group-hover:text-on-primary transition-colors" data-icon="biotech">biotech</span>
        </div>
        <h2 class="text-2xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight mb-4">{linha.titulo}</h2>
        <p class="text-sm leading-relaxed text-on-surface-variant/80">{linha.descricao}</p>
      </article>
    ))}
  </section>
</BaseLayout>
