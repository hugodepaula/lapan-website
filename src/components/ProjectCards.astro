---
import { buildProjectSummary } from "../lib/content-helpers";

interface Projeto {
  id: string;
  data: {
    titulo: string;
    resumo: string;
    resumoCurto?: string;
    area?: string;
    status: string;
    inicio?: string;
    imagem?: string;
    link?: string;
  };
}

interface Props {
  projetos: Projeto[];
  vazio: string;
}

const { projetos, vazio } = Astro.props;
---

{
  projetos.length === 0 ? (
    <section class="mt-8 rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
      <p class="text-on-surface-variant font-medium">{vazio}</p>
    </section>
  ) : (
    <section class="pt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {projetos.map((projeto) => (
        <article class="group rounded-2xl bg-surface-container-low p-6 transition-all duration-300 hover:bg-surface-container-high hover:-translate-y-1 border border-outline-variant/30">
          {projeto.data.imagem && (
            <div class="relative overflow-hidden rounded-xl aspect-video mb-6">
              <img
                src={projeto.data.imagem}
                alt={`Imagem do projeto ${projeto.data.titulo}`}
                class={`h-full w-full transition-transform duration-500 group-hover:scale-105 ${
                  projeto.data.imagem.includes("logo")
                    ? "bg-surface-container-highest object-contain p-6"
                    : "object-cover"
                }`}
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            </div>
          )}

          <div class="flex flex-col h-full">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-primary">
                {projeto.data.status}
              </span>
              {projeto.data.inicio && (
                <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-on-surface-variant/70">
                  Desde {projeto.data.inicio}
                </span>
              )}
            </div>
            
            <h2 class="text-xl font-bold leading-tight text-on-surface group-hover:text-primary transition-colors">
              <a href={`/projetos/${projeto.id}/`}>
                {projeto.data.titulo}
              </a>
            </h2>

            {projeto.data.area && (
              <p class="mt-2 text-xs font-bold uppercase tracking-widest text-secondary/80">
                {projeto.data.area}
              </p>
            )}

            <p class="mt-4 text-sm leading-relaxed text-on-surface-variant line-clamp-3">
              {buildProjectSummary(projeto.data)}
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={`/projetos/${projeto.id}`}
                class="btn-primary text-xs uppercase tracking-widest py-2.5 px-5"
              >
                Ver detalhes
              </a>
              {projeto.data.link && (
                <a
                  href={projeto.data.link}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-on-surface-variant transition hover:border-primary/50 hover:text-primary hover:bg-primary/5"
                >
                  Fonte externa
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>
  )
}
