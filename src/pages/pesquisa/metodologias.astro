---
import BaseLayout from "../../layouts/BaseLayout.astro";

const metodologias = [
  {
    titulo: "Triagem e estudos populacionais",
    descricao:
      "Aplicação de protocolos em escolas e grupos populacionais para identificar sinais de alteração visual e orientar encaminhamentos mais precoces.",
  },
  {
    titulo: "Avaliação funcional da visão",
    descricao:
      "Uso de testes de acuidade, sensibilidade ao contraste, percepção visual e leitura para compreender como a visão influencia o desempenho cotidiano.",
  },
  {
    titulo: "Rastreamento ocular e pupilometria",
    descricao:
      "Medições objetivas dos movimentos oculares e das respostas pupilares para apoiar diagnósticos mais precisos e desenvolvimento de instrumentos.",
  },
  {
    titulo: "Validação de instrumentos",
    descricao:
      "Desenvolvimento e comparação de métodos, equipamentos e protocolos para tornar a avaliação visual mais confiável e reproduzível.",
  },
];
---

<BaseLayout
  title="Metodologias | Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)"
  description="Metodologias de pesquisa do Laboratório de Pesquisa Aplicação à Neurociências da Visão (LAPAN)."
>
  <section class="mb-16">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-3">Protocolos e Técnicas</p>
    <h1 class="text-4xl text-on-surface sm:text-6xl font-black tracking-tighter leading-tight">Metodologias</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant/90 font-medium">
      O Laboratório de Pesquisa Aplicada à Neurociências da Visão (LAPAN)
      combina métodos clínicos, instrumentais e epidemiológicos para produzir
      resultados sólidos, unindo rigor científico e aplicabilidade.
    </p>
  </section>

  <section class="pb-12 grid gap-6 md:grid-cols-2">
    {metodologias.map((item) => (
      <article class="group card-tonal border border-outline-variant/30 p-8">
        <h2 class="text-2xl font-bold text-on-surface group-hover:text-primary transition-colors leading-tight mb-4">{item.titulo}</h2>
        <p class="text-base leading-relaxed text-on-surface-variant/80 font-medium">{item.descricao}</p>
      </article>
    ))}
  </section>
</BaseLayout>
