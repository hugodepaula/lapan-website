---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import publicacoesBrutas from "../../../content/zotero.json";
import {
  buildPersonSummary,
  buildProjectSummary,
} from "../../lib/content-helpers";
import {
  buildAbsoluteUrl,
  buildAssetUrl,
  getBaseUrl,
} from "../../lib/geo";
import { normalizarPublicacoes } from "../../lib/publicacoes";

export async function getStaticPaths() {
  const projetos = await getCollection("projects");

  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;

let membros = [];
let equipe = [];
let publicacoesRelacionadas = [];
let resumo = "";
let structuredData = [];

try {
  membros = await getCollection("team");
  const membrosMap = new Map(membros.map((membro) => [membro.id, membro]));
  equipe = (projeto.data.equipe ?? [])
    .map((slug: string) => membrosMap.get(slug))
    .filter(Boolean);

  const { publicacoes } = normalizarPublicacoes(publicacoesBrutas);
  publicacoesRelacionadas = publicacoes.filter((publicacao) =>
    (projeto.data.publicationKeywords ?? []).some((keyword: string) => {
      try {
        return publicacao.titulo.toLowerCase().includes(keyword.toLowerCase());
      } catch (e) {
        console.error(`Erro ao processar keyword "${keyword}" para o projeto "${projeto.id}":`, e);
        return false;
      }
    }),
  );

  resumo = buildProjectSummary(projeto.data);
  const baseUrl = getBaseUrl(Astro.site);
  const canonicalUrl = buildAbsoluteUrl(Astro.url.pathname, baseUrl);
  const image = projeto.data.imagem
    ? buildAssetUrl(projeto.data.imagem, baseUrl)
    : undefined;
  structuredData = [
    {
      "@context": "https://schema.org",
      "@type": "ResearchProject",
      "@id": `${canonicalUrl}#project`,
      url: canonicalUrl,
      name: projeto.data.titulo,
      description: resumo,
      image: image ? [image] : undefined,
      status: projeto.data.status,
      abstract: projeto.data.citationSummary ?? resumo,
      knowsAbout: projeto.data.areasTematicas,
      keywords: projeto.data.publicationKeywords,
      member: equipe.map((membro) => ({
        "@type": "Person",
        name: membro.data.nome,
        url: buildAbsoluteUrl(`/equipe/${membro.id}/`, baseUrl),
      })),
      funder: projeto.data.financiamento.map((item) => ({
        "@type": "Organization",
        name: item,
      })),
      sponsor: projeto.data.instituicoes.map((item) => ({
        "@type": "Organization",
        name: item,
      })),
      mainEntityOfPage: canonicalUrl,
    },
  ];
} catch (error) {
  console.error(`ERRO CRÍTICO no build do projeto ${projeto.id}:`, error);
  throw error;
}

const fontes = [...(projeto.data.fontes ?? [])];
---

<BaseLayout
  title={`${projeto.data.titulo} | Projetos LAPAN`}
  description={resumo}
  image={projeto.data.imagem}
  pageType="article"
  breadcrumbs={[
    { name: "Início", item: "/" },
    { name: "Projetos", item: "/projetos/" },
    { name: projeto.data.titulo },
  ]}
  structuredData={structuredData}
>
  <section class="grid gap-0 overflow-hidden rounded-3xl bg-surface-container-low border border-outline-variant/30 shadow-2xl lg:grid-cols-[1.2fr_0.8fr]">
    <div class="p-8 lg:p-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase border border-primary/20">
          {projeto.data.status}
        </span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/70">ID: #PROJ-{projeto.id.slice(0, 4).toUpperCase()}</span>
      </div>
      
      <h1 class="text-4xl text-on-surface sm:text-5xl font-black tracking-tighter leading-tight mb-8">
        {projeto.data.titulo}
      </h1>

      <div class="flex flex-wrap gap-3 mb-10">
        {projeto.data.inicio && (
          <span class="flex items-center gap-2 rounded-lg bg-surface-container-highest px-4 py-2 text-xs font-bold text-on-surface-variant border border-outline-variant/30">
            <span class="material-symbols-outlined text-sm text-primary" data-icon="calendar_today">calendar_today</span>
            Início: {projeto.data.inicio}
          </span>
        )}
        {projeto.data.area && (
          <span class="flex items-center gap-2 rounded-lg bg-surface-container-highest px-4 py-2 text-xs font-bold text-on-surface-variant border border-outline-variant/30">
            <span class="material-symbols-outlined text-sm text-primary" data-icon="science">science</span>
            {projeto.data.area}
          </span>
        )}
        {projeto.data.populacao && (
          <span class="flex items-center gap-2 rounded-lg bg-surface-container-highest px-4 py-2 text-xs font-bold text-on-surface-variant border border-outline-variant/30">
            <span class="material-symbols-outlined text-sm text-primary" data-icon="groups">groups</span>
            Público: {projeto.data.populacao}
          </span>
        )}
      </div>

      <p class="max-w-3xl text-lg leading-relaxed text-on-surface-variant/90 font-medium">
        {resumo}
      </p>

      <div class="mt-12 flex flex-wrap gap-4">
        {projeto.data.link && (
          <a
            href={projeto.data.link}
            target="_blank"
            rel="noreferrer"
            class="btn-primary text-xs uppercase tracking-widest py-3.5 px-8"
          >
            Acessar Fonte Principal
          </a>
        )}
        <a
          href="/projetos/"
          class="inline-flex items-center gap-2 rounded-md border border-outline-variant/30 px-6 py-3.5 text-xs font-bold uppercase tracking-widest text-on-surface-variant/90 transition hover:border-primary/50 hover:text-primary"
        >
          <span class="material-symbols-outlined text-sm" data-icon="arrow_back">arrow_back</span>
          Ver todos os projetos
        </a>
      </div>
    </div>

    <div class="relative min-h-80 bg-surface-container-highest overflow-hidden">
      <div class="flex h-full items-center justify-center bg-surface-container-high">
        <span class="material-symbols-outlined text-6xl text-primary/20">biotech</span>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
    </div>
  </section>

  <div class="grid gap-8 pt-16 xl:grid-cols-3">
    <article class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-primary" data-icon="help_outline">help_outline</span>
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-on-surface-variant/80">Pergunta Central</h3>
      </div>
      <p class="text-base leading-relaxed text-on-surface-variant/90 font-medium">
        {projeto.data.perguntaCentral ?? projeto.data.descricao}
      </p>
    </article>
    <article class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-primary" data-icon="architecture">architecture</span>
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-on-surface-variant/80">Metodologia</h3>
      </div>
      <p class="text-base leading-relaxed text-on-surface-variant/90 font-medium">
        {projeto.data.metodologia}
      </p>
    </article>
    <article class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30 shadow-xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-primary" data-icon="insights">insights</span>
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-on-surface-variant/80">Impacto e Aplicação</h3>
      </div>
      <p class="text-base leading-relaxed text-on-surface-variant/90 font-medium">
        {projeto.data.impacto}
      </p>
    </article>
  </div>

  { (projeto.data.metodos.length > 0 || projeto.data.achadosPrincipais.length > 0) && (
    <section class="pt-24 grid gap-8 lg:grid-cols-2">
      {projeto.data.metodos.length > 0 && (
        <article class="rounded-3xl bg-surface-container-low p-10 border border-outline-variant/30">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Protocolos Aplicados</h2>
          <ul class="space-y-4">
            {projeto.data.metodos.map((metodo) => (
              <li class="flex items-start gap-3 text-on-surface-variant/90">
                <span class="material-symbols-outlined text-primary text-sm mt-1" data-icon="check_circle">check_circle</span>
                <span class="text-base leading-relaxed font-medium">{metodo}</span>
              </li>
            ))}
          </ul>
        </article>
      )}

      {projeto.data.achadosPrincipais.length > 0 && (
        <article class="rounded-3xl bg-surface-container-low p-10 border border-outline-variant/30">
          <h2 class="text-2xl font-bold text-on-surface mb-8 border-l-4 border-primary pl-4">Evidências e Achados</h2>
          <ul class="space-y-4">
            {projeto.data.achadosPrincipais.map((achado) => (
              <li class="flex items-start gap-3 text-on-surface-variant/90">
                <span class="material-symbols-outlined text-primary text-sm mt-1" data-icon="stars">stars</span>
                <span class="text-base leading-relaxed font-medium">{achado}</span>
              </li>
            ))}
          </ul>
        </article>
      )}
    </section>
  )}

  <section class="pt-24">
    <div class="flex items-end justify-between gap-4 mb-10">
      <h2 class="text-3xl font-black tracking-tighter text-on-surface">Equipe de Investigação</h2>
      <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant/70">{equipe.length} investigador(es) vinculado(s)</p>
    </div>
    {equipe.length === 0 ? (
      <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30 text-center">
        <p class="text-on-surface-variant/90 font-medium opacity-60">
          Informações sobre a equipe vinculada estão em processamento editorial.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {equipe.map((membro) => (
          <article class="group rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 transition-all duration-300 hover:bg-surface-container-high">
            <div class="relative overflow-hidden rounded-xl aspect-square mb-4">
              <img
                src={membro.data.foto || "/images/logo_squared.png"}
                alt={`Foto de ${membro.data.nome}`}
                class="h-full w-full object-cover opacity-80 transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="text-base font-bold text-on-surface group-hover:text-primary transition-colors leading-tight">
              <a href={`/equipe/${membro.id}/`}>
                {membro.data.nome}
              </a>
            </h3>
            <p class="mt-1 text-[10px] font-black uppercase tracking-[0.2em] text-primary">{membro.data.cargo}</p>
          </article>
        ))}
      </div>
    )}
  </section>

  <div class="grid gap-12 pt-24 lg:grid-cols-[1.2fr_0.8fr]">
    <section>
      <h2 class="text-3xl font-black tracking-tighter text-on-surface mb-8">Produção Científica Vinculada</h2>
      {publicacoesRelacionadas.length === 0 ? (
        <div class="rounded-2xl bg-surface-container-low p-8 border border-outline-variant/30">
          <p class="text-on-surface-variant/90 font-medium italic">
            Nenhuma publicação automática identificada via metadados Zotero para este projeto.
          </p>
        </div>
      ) : (
        <div class="space-y-4">
          {publicacoesRelacionadas.map((publicacao) => (
            <article class="rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 hover:bg-surface-container-high transition-colors">
              <p class="text-sm leading-relaxed text-on-surface-variant/90 font-medium">
                {publicacao.referenciaAbnt}
              </p>
              {(publicacao.doiUrl || publicacao.urlExterna) && (
                <div class="mt-4 flex gap-3">
                  {publicacao.doiUrl && (
                    <a
                      href={publicacao.doiUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="text-[10px] font-black uppercase tracking-widest text-primary hover:text-primary-light transition-colors"
                    >
                      DOI →
                    </a>
                  )}
                  {publicacao.urlExterna && (
                    <a
                      href={publicacao.urlExterna}
                      target="_blank"
                      rel="noreferrer"
                      class="text-[10px] font-black uppercase tracking-widest text-primary hover:text-primary-light transition-colors"
                    >
                      {publicacao.urlExterna.endsWith(".pdf") ? "PDF" : "Fonte"} →
                    </a>
                  )}
                </div>
              )}
            </article>
          ))}
        </div>
      )}
    </section>

    <section>
      <h2 class="text-3xl font-black tracking-tighter text-on-surface mb-8">Rastreabilidade e Fontes</h2>
      <div class="space-y-6">
        {projeto.data.link && (
          <a
            href={projeto.data.link}
            target="_blank"
            rel="noreferrer"
            class="block rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 hover:bg-surface-container-high transition-all"
          >
            <p class="text-[10px] font-black uppercase tracking-widest text-primary mb-2">Repositório Principal</p>
            <p class="text-sm font-bold text-on-surface truncate">{projeto.data.link}</p>
          </a>
        )}
        
        {fontes.map((fonte) => (
          <a
            href={fonte.url}
            target="_blank"
            rel="noreferrer"
            class="block rounded-2xl bg-surface-container-low p-6 border border-outline-variant/30 hover:bg-surface-container-high transition-all"
          >
            <p class="text-[10px] font-black uppercase tracking-widest text-primary mb-2">{fonte.rotulo}</p>
            <p class="text-sm font-bold text-on-surface truncate">{fonte.url}</p>
          </a>
        ))}

        <div class="p-8 bg-surface-container-low rounded-3xl border border-outline-variant/30 shadow-2xl">
          <h3 class="text-xs font-black uppercase tracking-widest text-on-surface mb-6">Metadados Técnicos</h3>
          <dl class="space-y-4">
            {projeto.data.citationSummary && (
              <div>
                <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/70 mb-1">Citação Recomendada</dt>
                <dd class="text-sm text-on-surface-variant/90 italic leading-relaxed">{projeto.data.citationSummary}</dd>
              </div>
            )}
            {projeto.data.ultimaRevisao && (
              <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/70">Última Revisão</dt>
                <dd class="text-xs font-bold text-on-surface">{projeto.data.ultimaRevisao}</dd>
              </div>
            )}
            <div class="flex justify-between items-center py-3">
              <dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/70">Protocolo Geo</dt>
              <dd class="text-[10px] font-bold text-primary">Ativo / Certificado</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
